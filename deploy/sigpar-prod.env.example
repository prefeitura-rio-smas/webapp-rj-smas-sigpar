SIGPAR_DB=/var/lib/sigpar/prod/sigpar.sqlite
SIGPAR_FIREBASE_PROJECT=sigpar-smas
SIGPAR_CORS_ORIGINS=https://sigpar.web.app
SIGPAR_CHROME=/opt/sigpar/chromium/chrome-linux-arm64/chrome
SIGPAR_NOAUTH=0
TZ=America/Sao_Paulo
# Backup (F-D5): preencher quando o backup binário estiver habilitado
# SIGPAR_BACKUP_SHEET_ID=
# SIGPAR_BACKUP_DRIVE_FOLDER_ID=
# SIGPAR_BACKUP_SA_KEY=/etc/sigpar/sigpar-backup.json
